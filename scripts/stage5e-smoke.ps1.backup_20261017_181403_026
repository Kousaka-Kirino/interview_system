[CmdletBinding()]
param([string]$BaseUrl = 'http://127.0.0.1:8000')
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$checks = @(
    @{ name = '健康检查'; path = '/api/health' },
    @{ name = '简历列表'; path = '/api/resumes' },
    @{ name = '补充资料'; path = '/api/materials' },
    @{ name = '面试统计'; path = '/api/interviews/statistics' },
    @{ name = '历史记录'; path = '/api/interviews/history?limit=1&offset=0' }
)
$failed = 0
Write-Host "[Stage 5E] 正在检查：$BaseUrl" -ForegroundColor Cyan
foreach ($check in $checks) {
    $uri = $BaseUrl.TrimEnd('/') + $check.path
    try {
        $response = Invoke-WebRequest -Uri $uri -Method Get -TimeoutSec 15 -UseBasicParsing -ErrorAction Stop
        if ([int]$response.StatusCode -ne 200) {
            throw "HTTP $($response.StatusCode)"
        }
        $body = ConvertFrom-Json -InputObject $response.Content -ErrorAction Stop
        if ($check.path -eq '/api/health' -and $body.status -ne 'ok') {
            throw '健康检查 JSON 中的 status 不为 ok'
        }
        if ($check.path -eq '/api/interviews/statistics' -and $null -eq $body.total_sessions) {
            throw '统计接口没有 total_sessions 字段'
        }
        Write-Host "[OK] $($check.name) — HTTP 200" -ForegroundColor Green
    } catch {
        $failed++
        Write-Host "[FAIL] $($check.name) — $($_.Exception.Message)" -ForegroundColor Red
    }
}
if ($failed -gt 0) { throw "共有 $failed 个接口未通过检查，请先确认 FastAPI 是否启动及 Stage 4 路由是否正确。" }
Write-Host '[Stage 5E] 五个只读接口检查通过，不需要 DeepSeek Key。' -ForegroundColor Green
